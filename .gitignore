# Unanchored on purpose. This is a workspace now, and an anchored `/target/`
# would not ignore a `crates/*/target/` that a stray cargo invocation leaves
# behind — which then gets committed as build output.
target/
**/*.rs.bk
__pycache__/
*.py[cod]

# Release staging built by the `native-bundles` job. Local runs of that
# packaging step leave a multi-megabyte `cdylib` and its archive here, and an
# auto-commit hook will happily commit them.
dist/

# Local secrets — never commit; copy .env.example to .env
.env
.DS_Store

# Generated llvm-cov report from the local coverage gate.
/coverage.json

# Python checker imports create bytecode caches beside their scripts.
/scripts/__pycache__/
/scripts/__tests__/__pycache__/
